# ---------------------------------------------------------------------------
# Capital Markets Teams Agent MVP — backend configuration (.env.example)
# Copy to `.env` and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Microsoft Foundry (Agent Service) ---
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_NAME=capmarkets-research-agent
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o

# --- Azure AI Search (vector DB with document-level security) ---
SEARCH_ENDPOINT=https://<your-search>.search.windows.net
SEARCH_INDEX_NAME=capmarkets-research
SEARCH_API_VERSION=2026-05-01-preview

# --- Entra ID / OBO (per-user document-level trimming) ---
AAD_TENANT_ID=<tenant-guid>
AAD_CLIENT_ID=<app-registration-client-id>
AAD_CLIENT_SECRET=<app-registration-client-secret>
SEARCH_OBO_SCOPE=https://search.azure.com/.default

# --- Azure OpenAI (embeddings for vectorization) ---
AOAI_ENDPOINT=https://<your-aoai>.openai.azure.com
AOAI_API_VERSION=2024-12-01-preview
AOAI_EMBED_DEPLOYMENT=text-embedding-3-small
AOAI_EMBED_DIMS=1536

# --- Teams publish (Option A) — optional, only needed to publish to a Teams tenant ---
BOT_SERVICE_ARM_ID=
PUBLISH_SCOPE=Tenant

# --- Feature flags ---
# USE_NATIVE_ACL: true = AI Search 2026-05-01-preview query-time ACL (x-ms-query-source-authorization)
#                 false = GA security trimming (group_ids + search.in())
USE_NATIVE_ACL=true
# USE_DEPLOYED_AGENT: true = invoke the deployed Foundry agent via Responses API
#                     false = offline demo mode (deterministic local synthesis, no Azure calls)
USE_DEPLOYED_AGENT=true
# OFFLINE_MODE: force the whole backend to run without any Azure dependency (demo without infra)
OFFLINE_MODE=false

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Observability (optional) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
