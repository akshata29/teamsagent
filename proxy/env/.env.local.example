# Option B proxy — local/dev configuration (copy to .env). NEVER commit real secrets.

# Bot / Entra app backing the Custom Engine Agent (created by `atk provision`)
clientId=
clientSecret=
tenantId=

# Azure Bot OAuth connection used for Teams SSO (required)
AzureBotOAuthConnectionName=teams-sso

# OBO connection + scopes for downstream Azure AI Search
OBOConnectionName=search-obo
OBOScopes=https://search.azure.com/.default

# Capital Markets backend (Option B path)
BACKEND_URL=http://localhost:8010

# Demo persona fallback (production derives entitlements from Entra groups)
DEMO_PERSONA_ID=equity-research
